# Required in production: set a long random value; never commit the real secret.
SECRET_KEY=replace-with-a-long-random-secret

# Optional: OpenRouter API key for NEXO AI
NEXO_OPENROUTER_KEY=

# Persistent data directory on host (recommended on ParsPack / persistent disk)
# NEXO_DATA_DIR=/var/data

# Secure cookies when serving over HTTPS
NEXO_SECURE_COOKIES=false

# Port (ParsPack / most hosts set PORT automatically; default in code is 8000)
PORT=8000

# Owner is hardcoded as arad_kr — NEXO_ADMIN is no longer required.
